DirectoryIndex index.php

<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 20M
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [L]
</IfModule>
